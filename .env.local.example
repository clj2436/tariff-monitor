# 复制本文件为 .env.local，填入你的钉钉机器人信息
# cp .env.local.example .env.local

# 必填：钉钉群机器人 Webhook（含 access_token）
DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=你的token

# 加签模式下填写；若机器人安全设置用的是「自定义关键词」，留空即可
DINGTALK_SECRET=

# 关注规则：运营商:省份|省份;运营商:省份
# 运营商可用 mobile/移动、telecom/电信、unicom/联通、gb/广电、* 全部
# 省份用中文名，* 表示该运营商所有省份
WATCH_RULES=mobile:江西;telecom:新疆

# 可选：要 @ 的人，手机号逗号分隔
DINGTALK_AT_MOBILES=

# 可选：通知里附带的资费页面地址（本地预览时填 http://localhost:8000）
SITE_URL=http://localhost:8000
